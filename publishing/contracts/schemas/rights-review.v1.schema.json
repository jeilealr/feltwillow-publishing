{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bllt.example.invalid/schemas/rights-review.v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "rights-review"
    },
    "schema_version": {
      "const": 1
    },
    "example": {
      "type": "boolean"
    },
    "story_id": {
      "$ref": "https://bllt.example.invalid/schemas/common.v1.json#/$defs/id"
    },
    "language": {
      "$ref": "https://bllt.example.invalid/schemas/common.v1.json#/$defs/language"
    },
    "status": {
      "enum": [
        "pending",
        "cleared",
        "blocked"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "component": {
            "enum": [
              "underlying-story",
              "adaptation",
              "translation",
              "voices",
              "images",
              "music",
              "sound-effects",
              "video",
              "compute-resources"
            ]
          },
          "decision": {
            "enum": [
              "pending",
              "cleared",
              "blocked",
              "not-applicable"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_by": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "component",
          "decision",
          "evidence",
          "reviewed_by",
          "reviewed_at"
        ]
      }
    }
  },
  "required": [
    "kind",
    "schema_version",
    "example",
    "story_id",
    "language",
    "status",
    "checks"
  ]
}
