{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bllt.example.invalid/schemas/import-receipt.v1.json",
  "title": "Import receipt v1",
  "description": "Durable, append-only observation of one import attempt, stored in BLLT_PUBLISH_STATE_ROOT/receipts/. The archived tar lives at BLLT_MASTER_ROOT/handoffs/<archive sha256>.tar. Never an approval. Contract revision H2 (PROPOSED CONTRACT; not released).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "import-receipt"
    },
    "schema_version": {
      "const": 1
    },
    "example": {
      "type": "boolean"
    },
    "canonicalization": {
      "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/canonicalization"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^imp-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
    },
    "outcome": {
      "enum": [
        "accepted",
        "duplicate-identical",
        "rejected"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/error_code"
      },
      "uniqueItems": true,
      "maxItems": 200
    },
    "handoff_id": {
      "anyOf": [
        {
          "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/handoff_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/sha256"
        },
        "bytes": {
          "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/positive_count"
        }
      },
      "required": [
        "sha256",
        "bytes"
      ]
    },
    "expected_archive_sha256": {
      "anyOf": [
        {
          "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_digest_source": {
      "enum": [
        "operator-out-of-band",
        "not-provided"
      ]
    },
    "record_sha256": {
      "anyOf": [
        {
          "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload_sha256": {
      "anyOf": [
        {
          "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version_seen": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/handoff_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "consumer_supports": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "duplicate_of": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^imp-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "archival_locator": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^handoffs/[a-f0-9]{64}\\.tar$",
          "description": "Relative to BLLT_MASTER_ROOT (DECISIONS_H2 s.2)."
        },
        {
          "type": "null"
        }
      ]
    },
    "promoted": {
      "type": "boolean"
    },
    "staged_at": {
      "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/utc_timestamp"
    },
    "finished_at": {
      "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/utc_timestamp"
    },
    "operator": {
      "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/person"
    },
    "importer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tool_version": {
          "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/semver"
        },
        "publishing_commit": {
          "anyOf": [
            {
              "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/git_commit"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tool",
        "tool_version",
        "publishing_commit"
      ]
    },
    "authorizes_publication": {
      "const": false
    }
  },
  "required": [
    "kind",
    "schema_version",
    "example",
    "canonicalization",
    "receipt_id",
    "outcome",
    "errors",
    "handoff_id",
    "archive",
    "expected_archive_sha256",
    "expected_digest_source",
    "record_sha256",
    "payload_sha256",
    "schema_version_seen",
    "supersedes",
    "consumer_supports",
    "duplicate_of",
    "archival_locator",
    "promoted",
    "staged_at",
    "finished_at",
    "operator",
    "importer",
    "authorizes_publication"
  ]
}
