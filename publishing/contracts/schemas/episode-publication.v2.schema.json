{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bllt.example.invalid/schemas/episode-publication.v2.json",
  "title": "Episode publication v2",
  "description": "Persistent identity of one logical podcast episode in one show (Agent D, IC-D1): integer duration_ms; GUID/first date null only while prepared; guid_source; append-only revisions; observed enclosure kept apart from the submitted file. Contract revision H2 (PROPOSED CONTRACT; not released).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "episode-publication"
    },
    "schema_version": {
      "const": 2
    },
    "example": {
      "type": "boolean"
    },
    "canonicalization": {
      "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/canonicalization"
    },
    "show_id": {
      "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/id"
    },
    "episode_id": {
      "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/episode_id"
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "record_revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9998
            },
            "record_sha256": {
              "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/sha256"
            }
          },
          "required": [
            "record_revision",
            "record_sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "change": {
      "enum": [
        "prepared",
        "first-publication",
        "metadata-correction",
        "audio-replacement",
        "artwork-change",
        "host-migration",
        "withdrawal",
        "observation-refresh"
      ]
    },
    "release_id": {
      "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/release_id"
    },
    "release_sha256": {
      "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/sha256"
    },
    "authority": {
      "enum": [
        "spotify",
        "independent"
      ]
    },
    "state": {
      "enum": [
        "prepared",
        "published",
        "withdrawn"
      ]
    },
    "episode_type": {
      "enum": [
        "full",
        "trailer",
        "bonus"
      ]
    },
    "guid": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "guid_is_permalink": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "guid_source": {
      "anyOf": [
        {
          "enum": [
            "observed-from-host-feed",
            "generated-before-release",
            "retained-from-previous-host"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "first_published_at": {
      "anyOf": [
        {
          "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/utc_timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_pubdate_raw": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "submitted_audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/id"
        },
        "sha256": {
          "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/sha256"
        },
        "bytes": {
          "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/positive_count"
        },
        "media_type": {
          "enum": [
            "audio/mpeg",
            "audio/mp4",
            "audio/wav"
          ]
        },
        "duration_ms": {
          "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/positive_count"
        }
      },
      "required": [
        "asset_id",
        "sha256",
        "bytes",
        "media_type",
        "duration_ms"
      ]
    },
    "observed_enclosure": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/https_url"
            },
            "declared_length_bytes": {
              "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/safe_count"
            },
            "declared_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "delivered_sha256": {
              "anyOf": [
                {
                  "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "delivered_bytes": {
              "anyOf": [
                {
                  "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/positive_count"
                },
                {
                  "type": "null"
                }
              ]
            },
            "head_ok": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "range_ok": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "url",
            "declared_length_bytes",
            "declared_type",
            "delivered_sha256",
            "delivered_bytes",
            "head_ok",
            "range_ok"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "observation_id": {
              "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/observation_id"
            },
            "observation_sha256": {
              "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/sha256"
            }
          },
          "required": [
            "observation_id",
            "observation_sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "anyOf": [
        {
          "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/utc_timestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "schema_version",
    "example",
    "canonicalization",
    "show_id",
    "episode_id",
    "record_revision",
    "supersedes",
    "change",
    "release_id",
    "release_sha256",
    "authority",
    "state",
    "episode_type",
    "guid",
    "guid_is_permalink",
    "guid_source",
    "first_published_at",
    "first_pubdate_raw",
    "submitted_audio",
    "observed_enclosure",
    "evidence",
    "observed_at"
  ]
}
