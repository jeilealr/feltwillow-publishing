{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bllt.example.invalid/schemas/media-delivery.v2.json",
  "title": "Media delivery v2",
  "description": "Observed delivery of a media file by a provider (IC-B2: integer duration_ms replaces float seconds). Contract revision H2 (PROPOSED CONTRACT; not released).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "media-delivery"
    },
    "schema_version": {
      "const": 2
    },
    "example": {
      "type": "boolean"
    },
    "canonicalization": {
      "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/canonicalization"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset_sha256": {
            "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/sha256"
          },
          "provider": {
            "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/id"
          },
          "url": {
            "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/https_url"
          },
          "observed_sha256": {
            "anyOf": [
              {
                "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "observed_bytes": {
            "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/positive_count"
          },
          "duration_ms": {
            "anyOf": [
              {
                "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/positive_count"
              },
              {
                "type": "null"
              }
            ]
          },
          "observed_at": {
            "$ref": "https://bllt.example.invalid/schemas/common.v2.json#/$defs/utc_timestamp"
          },
          "access": {
            "enum": [
              "public",
              "private"
            ]
          },
          "review": {
            "enum": [
              "pending",
              "pass",
              "fail"
            ]
          }
        },
        "required": [
          "asset_sha256",
          "provider",
          "url",
          "observed_sha256",
          "observed_bytes",
          "duration_ms",
          "observed_at",
          "access",
          "review"
        ]
      },
      "maxItems": 10000
    }
  },
  "required": [
    "kind",
    "schema_version",
    "example",
    "canonicalization",
    "records"
  ]
}
