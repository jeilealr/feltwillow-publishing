{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feltwillow.example.invalid/schemas/publish-plan.v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "publish-plan"
    },
    "schema_version": {
      "const": 1
    },
    "example": {
      "type": "boolean"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "enum": [
        "preview",
        "production"
      ]
    },
    "project_sha256": {
      "$ref": "https://feltwillow.example.invalid/schemas/common.v1.json#/$defs/sha256"
    },
    "site_set_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "registry_sha256": {
      "$ref": "https://feltwillow.example.invalid/schemas/common.v1.json#/$defs/sha256"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "releases": {
      "type": "array",
      "items": {
        "$ref": "https://feltwillow.example.invalid/schemas/common.v1.json#/$defs/release_entry"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "enum": [
              "ghost",
              "static-site",
              "spotify",
              "youtube",
              "independent-rss",
              "directory"
            ]
          },
          "operation": {
            "enum": [
              "create-draft",
              "update-draft",
              "publish",
              "manual-upload",
              "manual-submit",
              "deploy",
              "withdraw"
            ]
          },
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_path": {
            "$ref": "https://feltwillow.example.invalid/schemas/common.v1.json#/$defs/path"
          },
          "artifact_sha256": {
            "$ref": "https://feltwillow.example.invalid/schemas/common.v1.json#/$defs/sha256"
          }
        },
        "required": [
          "action_id",
          "target",
          "operation",
          "subject_id",
          "artifact_path",
          "artifact_sha256"
        ]
      }
    },
    "newsletter_send": {
      "const": false
    },
    "auxiliary_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_kind": {
            "enum": [
              "show",
              "episode-publication",
              "media-delivery",
              "rights-review"
            ]
          },
          "path": {
            "$ref": "https://feltwillow.example.invalid/schemas/common.v1.json#/$defs/path"
          },
          "sha256": {
            "$ref": "https://feltwillow.example.invalid/schemas/common.v1.json#/$defs/sha256"
          }
        },
        "required": [
          "record_kind",
          "path",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "kind",
    "schema_version",
    "example",
    "plan_id",
    "created_at",
    "expires_at",
    "environment",
    "project_sha256",
    "site_set_sha256",
    "registry_sha256",
    "source_commit",
    "releases",
    "actions",
    "newsletter_send",
    "auxiliary_inputs"
  ]
}
