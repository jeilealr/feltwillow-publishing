{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feltwillow.example.invalid/schemas/common.v2.json",
  "title": "Feltwillow shared definitions v2 (H2)",
  "description": "Shared definitions for contract revision H2. common.v1 stays unchanged for v1 records. H2 adds https_url, episode_id, observation_id (IC-D10), canonicalization, module_id, handoff_package_digest, email, date and dirty_path (L-21). Contract revision H2 (PROPOSED CONTRACT; not released).",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "language": {
      "enum": [
        "en",
        "de",
        "es",
        "fr",
        "ru",
        "uk"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "safe_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "relpath": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*//)(?!(?:.*/)?\\.{1,2}(?:/|$))[A-Za-z0-9_@+-][A-Za-z0-9_.@+/-]*$"
    },
    "dirty_path": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*//)(?!(?:.*/)?\\.{1,2}(?:/|$))[A-Za-z0-9_.@+-][A-Za-z0-9_.@+/-]*$",
      "description": "L-21: recorded unrelated dirty path; like relpath but leading-dot segments (.gitignore, .claude/...) allowed; '.', '..', absolute and backslash forbidden."
    },
    "package_path": {
      "type": "string",
      "pattern": "^files/[a-z0-9]+(?:-[a-z0-9]+)*/[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.(?:en|de|es|fr|ru|uk)\\.h[0-9]{4}$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.(?:en|de|es|fr|ru|uk)\\.r[0-9]{4}$"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.(?:en|de|es|fr|ru|uk)$"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^obs-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
    },
    "https_url": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:/[^\\s\\\"'<>\\\\]*)?$"
    },
    "email": {
      "type": "string",
      "maxLength": 254,
      "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}$"
    },
    "person": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "error_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "canonicalization": {
      "const": "feltwillow-canonical-json-v1",
      "description": "v2 canonical-json-v1 bytes within the H1 safe domain (normative)."
    },
    "module_id": {
      "enum": [
        "astro",
        "ghost",
        "plain_static"
      ],
      "description": "IC-C3: one spelling in every record; folders web/astro, web/ghost-theme, web/plain-static."
    },
    "role": {
      "enum": [
        "spoken-transcript",
        "audio-master",
        "illustration",
        "cover-art",
        "video-master",
        "video-delivery",
        "thumbnail",
        "captions",
        "chapters"
      ]
    },
    "media_type": {
      "enum": [
        "application/vnd.feltwillow.reading-blocks+json",
        "text/plain",
        "audio/wav",
        "audio/flac",
        "audio/mpeg",
        "audio/mp4",
        "image/png",
        "image/jpeg",
        "image/webp",
        "video/mp4",
        "video/quicktime",
        "text/vtt",
        "application/json"
      ]
    },
    "rights_component": {
      "enum": [
        "underlying-story",
        "adaptation",
        "translation",
        "voices",
        "images",
        "music",
        "sound-effects",
        "video",
        "compute-resources"
      ]
    },
    "private_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Opaque PRIVATE locator (production-relative path, owner-store label). Provenance only: never a permission to read a production checkout, never a URL."
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "https://feltwillow.example.invalid/schemas/common.v2.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ref",
        "sha256"
      ]
    },
    "contract_package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "feltwillow-contracts"
        },
        "version": {
          "$ref": "https://feltwillow.example.invalid/schemas/common.v2.json#/$defs/semver"
        },
        "archive_sha256": {
          "$ref": "https://feltwillow.example.invalid/schemas/common.v2.json#/$defs/sha256"
        }
      },
      "required": [
        "name",
        "version",
        "archive_sha256"
      ]
    },
    "handoff_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handoff_id": {
          "$ref": "https://feltwillow.example.invalid/schemas/common.v2.json#/$defs/handoff_id"
        },
        "payload_sha256": {
          "$ref": "https://feltwillow.example.invalid/schemas/common.v2.json#/$defs/sha256"
        }
      },
      "required": [
        "handoff_id",
        "payload_sha256"
      ]
    },
    "reading_edition_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.(?:en|de|es|fr|ru|uk)\\.e[0-9]{4}$"
    },
    "reading_edition_pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edition_id": {
          "$ref": "#/$defs/reading_edition_id"
        },
        "edition_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "edition_id",
        "edition_sha256"
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "enum": [
            "feltwillow-stdlib",
            "ffprobe"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "tool",
        "version"
      ],
      "description": "L-29: tool that measured the asset bytes and its version."
    },
    "handoff_package_digest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handoff_id": {
          "$ref": "https://feltwillow.example.invalid/schemas/common.v2.json#/$defs/handoff_id"
        },
        "payload_sha256": {
          "$ref": "https://feltwillow.example.invalid/schemas/common.v2.json#/$defs/sha256"
        },
        "archive_sha256": {
          "$ref": "https://feltwillow.example.invalid/schemas/common.v2.json#/$defs/sha256"
        }
      },
      "required": [
        "handoff_id",
        "payload_sha256",
        "archive_sha256"
      ]
    },
    "release_pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release_id": {
          "$ref": "https://feltwillow.example.invalid/schemas/common.v2.json#/$defs/release_id"
        },
        "release_sha256": {
          "$ref": "https://feltwillow.example.invalid/schemas/common.v2.json#/$defs/sha256"
        }
      },
      "required": [
        "release_id",
        "release_sha256"
      ]
    },
    "approval_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "$ref": "https://feltwillow.example.invalid/schemas/common.v2.json#/$defs/id"
        },
        "approval_sha256": {
          "$ref": "https://feltwillow.example.invalid/schemas/common.v2.json#/$defs/sha256"
        }
      },
      "required": [
        "approval_id",
        "approval_sha256"
      ]
    },
    "frame_rate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "$ref": "https://feltwillow.example.invalid/schemas/common.v2.json#/$defs/positive_count"
        },
        "denominator": {
          "$ref": "https://feltwillow.example.invalid/schemas/common.v2.json#/$defs/positive_count"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    }
  }
}
